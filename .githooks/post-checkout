#!/bin/bash
# Reinstall dependencies after switching branches, but only when they differ.
# $1 = previous HEAD, $2 = new HEAD, $3 = 1 for a branch checkout, 0 for a file checkout

[ "$3" = "1" ] || exit 0

if [ ! -d vendor ] || ! git diff --quiet "$1" "$2" -- composer.lock 2>/dev/null; then
    composer install
fi
